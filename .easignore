# EAS uploads from git root in this monorepo — exclude everything not needed for patient-app.

# Always
**/node_modules/
**/.expo/
**/.git/
**/.DS_Store
**/*.pem
**/*.p8
**/*.p12
**/*.jks
**/*.mobileprovision
**/.env*.local
**/dist/
**/web-build/
**/coverage/
**/__pycache__/
**/.venv*/
**/.playwright-browsers/
**/.sandbox-trial/
**/.pr-worktrees/
**/.pr-patches/
**/.gcloud-tmp/
**/.ci-watch*.log
**/tmp/
**/test-results/
**/perf/
middleware-dev.db*
*.db-wal
*.db-shm

# Heavy packages not required for patient-app EAS iOS build
middleware-platform/
unified-dashboard/
Knowledge/
docs/
scripts/
todos/
livekit-agents/
case-report-service/
medical-rag-api/
infra/
/assets/
config/
contracts/
local/
inference/
cypress.config.js
phase0-verify.cjs
ecosystem.config.js
netlify.toml
tailwind.config.js
ARCHITECTURE.md
CONTRIBUTING.md

# patient-app extras
patient-app/ios/
patient-app/android/
patient-app/app-example/
patient-app/**/*.test.ts
patient-app/**/*.test.tsx
patient-app/lib/__tests__/
