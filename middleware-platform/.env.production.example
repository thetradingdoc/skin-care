# Production Cloud Run — non-secret env (copy secrets to Secret Manager).
# Verify before deploy:
#   node middleware-platform/scripts/verify-prod-consumer-env.cjs --file middleware-platform/.env.production

NODE_ENV=production

# Consumer v3 agentic stack (required)
FEATURE_V3_INSIGHTS=1
FEATURE_V3_INSIGHTS_LLM=1
LANGGRAPH_CONSUMER_EVAL_ROLLOUT_PCT=1
NEXT_GEN_PIPELINE=1
CONSUMER_RAILS_MAX_TOOL_ITERATIONS=3

# Journal-first mode (required for diary UX)
JOURNAL_MODE_STANDALONE=1
TRIGGER_INSIGHTS_ENABLED=1
IMPROVEMENTS_API_ENABLED=1

# Billing (required — set real Stripe price id)
STRIPE_PRICE_CARE_PROGRAM=price_REPLACE_ME

# DB (production defaults from generate-cloudrun-env-yaml.cjs)
DB_PATH=/var/data/middleware-prod.db
GCS_DB_BUCKET=somo-prod-db-somo-callsomo
SKIP_STARTUP_MIGRATIONS=1
