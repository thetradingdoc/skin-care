# Copy to .env in this folder. Restart: npx expo start --clear
#
# --- API URL strategy (Skin & Care) ---
#
# Production / TestFlight / App Store (required on physical device):
#   Always use the shared Somo middleware — deploy runs on somo-platform only.
EXPO_PUBLIC_API_BASE_URL=https://api.callsomo.com
#
# Local middleware on same machine (simulator):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
#
# Local middleware + ngrok (physical device on another network):
# EXPO_PUBLIC_API_BASE_URL=https://your-subdomain.ngrok-free.app
#
# Same Wi-Fi LAN, no tunnel (physical device):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
#
# EAS profiles (eas.json) set EXPO_PUBLIC_API_BASE_URL for preview/production builds.
# Consumer web signup link on sign-in screen:
# EXPO_PUBLIC_WEB_SIGNUP_URL=https://myskinandcare.com/scan
#
# Optional — non-interactive EAS iOS build (set in shell, never commit):
# export EXPO_APPLE_ID="your-apple-id@email.com"
# export EXPO_APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# export EXPO_APPLE_TEAM_ID="33PP5ZAK59"
#
# Dev only — pre-fill login email (do not use in store builds):
# EXPO_PUBLIC_DEMO_PATIENT_EMAIL=
#
# Face-read requires live GPU inference on middleware (no client mock).
# Middleware: FACE_READ_INFERENCE_BASE_URL=http://127.0.0.1:8765 (teamkelly).
# Runbook: docs/runbooks/FACE_READ_INFERENCE.md
# Smoke test: node patient-app/scripts/smoke-face-read.cjs
