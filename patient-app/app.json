{
  "expo": {
    "name": "touche — Skin Journal",
    "slug": "skin-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "patientapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skinandcare.app",
      "infoPlist": {
        "CFBundleDisplayName": "touche",
        "NSCameraUsageDescription": "touche uses the camera for daily progress photos so you can track changes in your skin over time.",
        "NSPhotoLibraryUsageDescription": "touche can save progress photos from your library when you choose to upload instead of taking a new photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.skinandcare.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "touche uses the camera for daily progress photos so you can track changes in your skin over time.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "touche can save progress photos from your library when you choose to upload instead of taking a new photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16b5d1d9-a703-4035-b41a-be2401f95c68"
      },
      "privacyPolicyUrl": "https://myskinandcare.com/patients/legal/privacy.html",
      "supportUrl": "https://trytouche.com/pages/contact"
    }
  }
}
