{
  "name": "patient-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:expo": "node ./scripts/verify-expo-device.cjs",
    "smoke:face-read": "node ./scripts/smoke-face-read.cjs",
    "start:device": "expo start --tunnel --clear",
    "verify:testflight": "node ./scripts/verify-testflight-prereqs.cjs",
    "verify:release": "npm run typecheck && npm test && npm run verify:testflight",
    "doctor:testflight": "node ./scripts/testflight-doctor.cjs",
    "build:testflight": "npx eas-cli build --platform ios --profile testflight",
    "build:testflight:submit": "npx eas-cli build --platform ios --profile testflight --auto-submit",
    "build:testflight:asc": "node ./scripts/run-testflight-with-asc.cjs",
    "build:testflight:asc:ci": "node ./scripts/run-testflight-with-asc.cjs --non-interactive",
    "submit:testflight:asc": "node ./scripts/run-submit-with-asc.cjs",
    "submit:testflight": "npx eas-cli submit --platform ios --profile testflight --latest",
    "verify:agentic-checkout": "node ../scripts/verify-agentic-checkout.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/gloock": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tabler/icons-react-native": "^3.44.0",
    "@zxing/browser": "^0.2.0",
    "expo": "~54.0.33",
    "expo-camera": "~16.1.6",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~13.1.6",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.11.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "swr": "^2.3.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated@~4.0.1",
        "react-native-reanimated@~4.1.1"
      ]
    }
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "eas-cli": "^16.32.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.6"
  },
  "private": true
}
