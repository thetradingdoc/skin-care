# Copy to .env.local for Vite dev. Restart: npm run dev

# Mock face-read when GPU / teamkelly is unavailable (recommended for local Vite-only dev)
VITE_FACE_READ_MOCK=1

# Optional: proxy /api to middleware (default http://127.0.0.1:4000)
# VITE_API_PROXY=http://127.0.0.1:4000

# Production consumer build (Firebase hosting-dist-consumer). Leave unset for local dev (relative /api).
# VITE_API_BASE=https://api.myskinandcare.com

# Optional app store links (shown on landing when set)
# VITE_IOS_APP_URL=https://testflight.apple.com/...
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=...
