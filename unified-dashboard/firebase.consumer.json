{
  "hosting": {
    "site": "myskinandcare",
    "public": "hosting-dist-consumer",
    "cleanUrls": true,
    "ignore": ["firebase.json", "firebase.consumer.json", "**/.*"],
    "redirects": [
      {
        "source": "/privacy",
        "destination": "https://app.trytouche.com/privacy",
        "type": 301
      },
      {
        "source": "/privacy.html",
        "destination": "https://app.trytouche.com/privacy",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "https://app.trytouche.com/terms",
        "type": 301
      },
      {
        "source": "/terms.html",
        "destination": "https://app.trytouche.com/terms",
        "type": 301
      },
      {
        "source": "/patients/legal/privacy.html",
        "destination": "https://app.trytouche.com/privacy",
        "type": 301
      },
      {
        "source": "/patients/legal/terms.html",
        "destination": "https://app.trytouche.com/terms",
        "type": 301
      },
      {
        "source": "/app/:path*",
        "destination": "https://app.trytouche.com/app/:path",
        "type": 301
      },
      {
        "source": "/",
        "destination": "https://trytouche.com/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://trytouche.com/:path",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
