{
  "hosting": {
    "site": "app-trytouche",
    "public": "hosting-dist-consumer",
    "cleanUrls": true,
    "ignore": ["firebase.json", "firebase.consumer.json", "firebase.app-trytouche.json", "**/.*"],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/app/**/*.@(ttf|woff|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "/assets/index-*.js",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/app/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      { "source": "/app", "destination": "/app/index.html" },
      { "source": "/app/index", "destination": "/app/index.html" },
      { "source": "/app/shop", "destination": "/app/shop/index.html" },
      {
        "source": "/app/shop/**",
        "destination": "/app/shop/[handle].html"
      },
      { "source": "/app/get-the-app", "destination": "/app/get-the-app.html" },
      { "source": "/app/**", "destination": "/app/index.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
